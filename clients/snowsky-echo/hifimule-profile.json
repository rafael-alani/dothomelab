        "Type": "Audio"
      },
      {
        "Container": "ogg",
        "Type": "Audio"
      },
      {
        "Container": "wav",
        "Type": "Audio"
      },
      {
        "Container": "ape",
        "Type": "Audio"
      },
      {
        "Container": "dsf",
        "Type": "Audio"
      },
      {
        "Container": "dff",
        "Type": "Audio"
      },
      {
        "Container": "wma",
        "Type": "Audio"
      }
    ],
    "TranscodingProfiles": [
      {
        "Container": "flac",
        "Type": "Audio",
        "AudioCodec": "flac",
