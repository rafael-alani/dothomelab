{
  "id": null,
  "uid": "blog",
  "title": "Blog \u2014 HTTP and logs",
  "description": "Shared blog monitoring. Select the environment; Umami holds readership. Old links remain valid.",
  "tags": [
    "blog"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Umami readership",
      "type": "link",
      "url": "https://analytics.rafael.media/",
      "targetBlank": true
    },
    {
      "title": "Prometheus alert states",
      "type": "link",
      "url": "https://prometheus.rafael.media/alerts",
      "targetBlank": true
    },
    {
      "title": "All homelab services",
      "url": "/d/homelab",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "What this dashboard measures",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "description": "",
      "options": {
        "mode": "markdown",
        "content": "Use **Environment** above to select production or staging. Endpoint checks run from Infra. Request logs exclude marked health checks. Requests are not readers; use Umami for readership. Alert states do not deliver notifications."
      }
    },
    {
      "id": 2,
      "title": "Private HTTPS and direct origin endpoint checks",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Latest probe result",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "description": "1 means HTTP/TLS/content checks passed; 0 means failed; no data is a monitoring gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{project=\"blog\",environment=\"$environment\",job=~\"blog.*(https|origin)\"}",
          "legendFormat": "{{page}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Passed",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Successful sampled probes",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "description": "Percentage of collected probe samples that passed in the selected range. Missing samples are not counted; inspect scrape health and missing-probe alerts. This is sampled availability, not guaranteed uptime.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg_over_time(probe_success{project=\"blog\",environment=\"$environment\",job=~\"blog.*(https|origin)\"}[$__range])",
          "legendFormat": "{{page}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "HTTPS certificate remaining",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "description": "Days until the earliest certificate expiry observed on the private HTTPS route. TLS verification remains enabled.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{environment=\"$environment\",job=~\"blog.*https\",page=\"home\"} - time()) / 86400",
          "legendFormat": "HTTPS certificate",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "Probe duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "description": "Total duration of each synthetic check from CT114; does not measure browser rendering or client-side navigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{project=\"blog\",environment=\"$environment\",job=~\"blog.*(https|origin)\"}",
          "legendFormat": "{{page}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP status returned",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "description": "Expected status is 200. Zero or missing data can mean failure before an HTTP response.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{project=\"blog\",environment=\"$environment\",job=~\"blog.*(https|origin)\"}",
          "legendFormat": "{{page}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Monitoring health \u2014 scrape success is different from endpoint success",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "title": "Prometheus scrape health",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 5
      },
      "description": "1 means Prometheus obtained metrics, even if an endpoint probe failed. Zero means collection failed. No samples is not success.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{project=\"blog\",environment=\"$environment\"}",
          "legendFormat": "{{job}} {{page}}",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Scrape failed",
                  "color": "red"
                },
                "1": {
                  "text": "Scraped",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "title": "Firing rules \u2014 no notification delivery",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 6,
        "h": 5
      },
      "description": "Rules evaluate in Prometheus, but no Alertmanager receiver is configured. Open Prometheus Alerts for pending/firing details.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertname=~\"(Production)?Blog.*\",environment=\"$environment\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing rules",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 11,
      "title": "Delivery drops in selected range",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 19,
        "w": 6,
        "h": 5
      },
      "description": "Logs dropped after Alloy exhausted Loki delivery retries. A zero value does not prove the source generated or retained all requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(loki_write_dropped_entries_total{environment=\"$environment\",job=~\"blog.*alloy\"}[$__range]))",
          "legendFormat": "Dropped lines",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 12,
      "title": "Journal read / Loki sent lines per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "description": "Pipeline activity includes synthetic checks and precedes traffic filtering. Compare against requests generated during acceptance.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_source_journal_target_lines_total{environment=\"$environment\",job=~\"blog.*alloy\"}[$__rate_interval]))",
          "legendFormat": "Journal lines read / second",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(loki_write_sent_entries_total{environment=\"$environment\",job=~\"blog.*alloy\"}[$__rate_interval]))",
          "legendFormat": "Lines sent to Loki / second",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Loki delivery retry rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "description": "Retry activity indicates delivery trouble even before entries are dropped.",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_write_batch_retries_total{environment=\"$environment\",job=~\"blog.*alloy\"}[$__rate_interval]))",
          "legendFormat": "Retries / second",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "title": "Origin server requests \u2014 synthetic checks excluded; requests are not visitors",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "title": "Server requests in selected range",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"blog\",environment=\"$environment\"} | json | __error__=\"\" | synthetic=\"none\" [$__range]))",
          "legendFormat": "Requests",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
