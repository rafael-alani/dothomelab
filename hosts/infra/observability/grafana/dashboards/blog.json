    {
      "id": 18,
      "title": "Origin request duration p95 (5m)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 5
      },
      "description": "nginx request processing duration, including sending the response. Not a browser page-load percentile.",
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_name=\"blog\",environment=\"$environment\"} | json | synthetic=\"none\" | unwrap request_time | __error__=\"\" [5m]) by ()",
          "legendFormat": "p95",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
      "id": 19,
      "title": "Requests per second by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "homelab-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({service_name=\"blog\",environment=\"$environment\"} | json | __error__=\"\" | synthetic=\"none\" [$__interval]))",
          "legendFormat": "HTTP {{status}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "homelab-loki"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
