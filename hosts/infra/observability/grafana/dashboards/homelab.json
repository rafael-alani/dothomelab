{
  "uid": "homelab",
  "title": "Homelab",
  "id": null,
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "1m",
  "description": "One shared platform. Select project, environment, guest and service. Pulse supplies cached resource metrics; Loki contains resource state changes and declared sanitized application logs. No notification receiver is configured.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": {
          "query": "label_values(homelab_resource_online, project)",
          "refId": "project"
        },
        "definition": "label_values(homelab_resource_online, project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": {
          "query": "label_values(homelab_resource_online{project=~\"$project\"}, environment)",
          "refId": "environment"
        },
        "definition": "label_values(homelab_resource_online{project=~\"$project\"}, environment)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "guest",
        "label": "Guest",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": {
          "query": "label_values(homelab_resource_online{project=~\"$project\",environment=~\"$environment\"}, guest)",
          "refId": "guest"
        },
        "definition": "label_values(homelab_resource_online{project=~\"$project\",environment=~\"$environment\"}, guest)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "homelab-prometheus"
        },
        "query": {
          "query": "label_values(homelab_resource_online{project=~\"$project\",environment=~\"$environment\",guest=~\"$guest\"}, service_name)",
          "refId": "service"
        },
        "definition": "label_values(homelab_resource_online{project=~\"$project\",environment=~\"$environment\",guest=~\"$guest\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Resources reported online \u2014 check freshness alongside this",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "homelab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(homelab_resource_online{project=~\"$project\",environment=~\"$environment\",guest=~\"$guest\",service_name=~\"$service\"})",
          "legendFormat": "{{guest}} / {{resource}}",
          "datasource": {
            "type": "prometheus",
            "uid": "homelab-prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Resources with fresh observations",
      "type": "stat",
