[Unit]
Description=Export existing Pulse resource measurements to shared monitoring
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/dothomelab-observability/current/hosts/infra/observability/collect-fleet.py
TimeoutStartSec=55
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/appdata/docker/observability/fleet
ProtectHome=read-only
