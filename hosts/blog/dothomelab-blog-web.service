[Unit]
Description=Static blog files (native nginx)
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
RuntimeDirectory=dothomelab-blog-web
ExecStart=/usr/sbin/nginx -c /etc/dothomelab/blog-nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
SyslogIdentifier=dothomelab-blog

[Install]
WantedBy=multi-user.target
