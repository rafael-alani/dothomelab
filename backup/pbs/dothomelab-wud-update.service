[Unit]
Description=Run routine OS and sequential WUD updates after a successful appdata backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/dothomelab/wud-update.conf
ExecStartPre=/usr/local/sbin/dothomelab-os-update
ExecStart=/usr/local/sbin/dothomelab-wud-update
TimeoutStartSec=4h
