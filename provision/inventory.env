# Declarative, non-secret desired state for the physical Proxmox node.
# Secrets and application credentials live only in /root/.env.

PVE_NODE_NAME="afa"
PVE_MIN_MAJOR="9"
PVE_BRIDGE="vmbr0"
LAN_CIDR="192.168.0.0/24"
LAN_PREFIX="24"
LAN_GATEWAY="192.168.0.1"
BOOTSTRAP_DNS="9.9.9.9"
PIHOLE_IP="192.168.0.100"
PVE_IP="192.168.0.250"

RPOOL_NAME="rpool"
VAULT_POOL_NAME="vault"
APPDATA_PARENT_DATASET="rpool/appdata"
APPDATA_DATASET="rpool/appdata/docker"
APPDATA_MOUNT="/srv/appdata/docker"
SHARED_DATASET="vault/shared"
SHARED_MOUNT="/vault/shared"

# Books/audiobooks/podcasts/music data contract. These are host paths, not
# container mount targets. Later phases may add a narrow CT112 read-write bind
# only after the current upstream container path is known; CT112 /data remains
# read-only. CT102 already has the required read-write view at /data.
MEDIA_BOOKS_HOST_PATH="$SHARED_MOUNT/media/books"
MEDIA_EBOOKS_HOST_PATH="$MEDIA_BOOKS_HOST_PATH/ebooks"
MEDIA_PDFS_HOST_PATH="$MEDIA_BOOKS_HOST_PATH/pdfs"
MEDIA_COMICS_HOST_PATH="$SHARED_MOUNT/media/comics"
MEDIA_MANGAS_HOST_PATH="$SHARED_MOUNT/media/mangas"
MEDIA_AUDIOBOOKS_HOST_PATH="$SHARED_MOUNT/media/audiobooks"
MEDIA_PODCASTS_HOST_PATH="$SHARED_MOUNT/media/podcasts"
PINEPODS_PODCASTS_HOST_PATH="$MEDIA_PODCASTS_HOST_PATH/pinepods"
MEDIA_MUSIC_HOST_PATH="$SHARED_MOUNT/media/music"
AURRAL_FLOWS_HOST_PATH="$SHARED_MOUNT/media/aurral-flows"
STORYTELLER_SHARED_HOST_PATH="$SHARED_MOUNT/media/storyteller"
STORYTELLER_INBOX_HOST_PATH="$STORYTELLER_SHARED_HOST_PATH/inbox"
STORYTELLER_LIBRARY_HOST_PATH="$STORYTELLER_SHARED_HOST_PATH/library"

SHELFARR_APPDATA_HOST_PATH="$APPDATA_MOUNT/shelfarr"
BOOKORBIT_APPDATA_HOST_PATH="$APPDATA_MOUNT/bookorbit"
AUDIOBOOKSHELF_APPDATA_HOST_PATH="$APPDATA_MOUNT/audiobookshelf"
STORYTELLER_APPDATA_HOST_PATH="$APPDATA_MOUNT/storyteller"
PINEPODS_APPDATA_HOST_PATH="$APPDATA_MOUNT/pinepods"
AURRAL_APPDATA_HOST_PATH="$APPDATA_MOUNT/aurral"
SOULARR_APPDATA_HOST_PATH="$APPDATA_MOUNT/soularr"
NAVIDROME_APPDATA_HOST_PATH="$APPDATA_MOUNT/navidrome"

MEDIA_CONTRACT_SHARED_UID="101000"
MEDIA_CONTRACT_SHARED_GID="100996"
MEDIA_CONTRACT_SHARED_MODE="0755"
MEDIA_CONTRACT_APPDATA_UID="101000"
MEDIA_CONTRACT_APPDATA_GID="101000"
MEDIA_CONTRACT_APPDATA_MODE="0750"
MEDIA_CONTRACT_MIN_SHARED_FREE_GIB="1024"
MEDIA_CONTRACT_MIN_APPDATA_FREE_GIB="64"

MEDIA_CONTRACT_SHARED_PATHS=(
  "$MEDIA_BOOKS_HOST_PATH"
  "$MEDIA_EBOOKS_HOST_PATH"
  "$MEDIA_PDFS_HOST_PATH"
  "$MEDIA_COMICS_HOST_PATH"
  "$MEDIA_MANGAS_HOST_PATH"
  "$MEDIA_AUDIOBOOKS_HOST_PATH"
  "$MEDIA_PODCASTS_HOST_PATH"
  "$PINEPODS_PODCASTS_HOST_PATH"
  "$MEDIA_MUSIC_HOST_PATH"
  "$AURRAL_FLOWS_HOST_PATH"
  "$STORYTELLER_SHARED_HOST_PATH"
  "$STORYTELLER_INBOX_HOST_PATH"
  "$STORYTELLER_LIBRARY_HOST_PATH"
)
readonly -a MEDIA_CONTRACT_SHARED_PATHS

MEDIA_CONTRACT_APPDATA_PATHS=(
  "$SHELFARR_APPDATA_HOST_PATH"
  "$BOOKORBIT_APPDATA_HOST_PATH"
  "$AUDIOBOOKSHELF_APPDATA_HOST_PATH"
  "$STORYTELLER_APPDATA_HOST_PATH"
  "$PINEPODS_APPDATA_HOST_PATH"
  "$AURRAL_APPDATA_HOST_PATH"
  "$SOULARR_APPDATA_HOST_PATH"
  "$NAVIDROME_APPDATA_HOST_PATH"
)
readonly -a MEDIA_CONTRACT_APPDATA_PATHS

YTDLP_DOWNLOADS_HOST_PATH="$SHARED_MOUNT/media/yt-dlp"
YTDLP_DOWNLOADS_GUEST_PATH="/downloads"
SLSKD_MUSIC_HOST_PATH="$MEDIA_MUSIC_HOST_PATH"
SLSKD_MUSIC_GUEST_PATH="/music"
SLSKD_DOWNLOADS_HOST_PATH="$SHARED_MOUNT/media/slskd"
SLSKD_DOWNLOADS_GUEST_PATH="/slskd-downloads"
AUDIOBOOKSHELF_PODCASTS_HOST_PATH="$MEDIA_PODCASTS_HOST_PATH"
AUDIOBOOKSHELF_PODCASTS_GUEST_PATH="/podcasts"
PBS_DATASET="vault/pbs_datastore"
PBS_MOUNT="/vault/pbs_datastore"
PBS_DATASET_QUOTA="2T"

PVE_TEMPLATE_STORAGE="local"
PVE_ROOTFS_STORAGE="local-zfs"
DEBIAN_12_TEMPLATE="debian-12-standard_12.7-1_amd64.tar.zst"
DEBIAN_13_TEMPLATE="debian-13-standard_13.1-2_amd64.tar.zst"

APPLICATION_CTIDS=(102 110 112)
PULSE_DOCKER_CTIDS=(102 110 112)
ALL_CTIDS=(102 110 112 113)

CT_HOSTNAME=()
CT_HOSTNAME[102]="servarr"
CT_HOSTNAME[110]="infra"
CT_HOSTNAME[112]="apps"
CT_HOSTNAME[113]="proxmox-backup-server"
readonly -a CT_HOSTNAME

CT_IP=()
CT_IP[102]="192.168.0.102"
CT_IP[110]="192.168.0.110"
CT_IP[112]="192.168.0.112"
CT_IP[113]="192.168.0.159"
readonly -a CT_IP

CT_MAC=()
CT_MAC[102]="BC:24:11:33:D6:AB"
CT_MAC[110]="BC:24:11:EB:87:25"
CT_MAC[112]="BC:24:11:59:D3:01"
CT_MAC[113]="BC:24:11:E0:F9:AD"
readonly -a CT_MAC

CT_CORES=()
CT_CORES[102]="2"
CT_CORES[110]="2"
CT_CORES[112]="5"
CT_CORES[113]="2"
readonly -a CT_CORES

CT_MEMORY=()
CT_MEMORY[102]="4096"
CT_MEMORY[110]="4096"
CT_MEMORY[112]="12288"
CT_MEMORY[113]="2048"
readonly -a CT_MEMORY

CT_SWAP=()
CT_SWAP[102]="512"
CT_SWAP[110]="512"
CT_SWAP[112]="1024"
CT_SWAP[113]="512"
readonly -a CT_SWAP

CT_ROOTFS_GB=()
CT_ROOTFS_GB[102]="8"
CT_ROOTFS_GB[110]="8"
CT_ROOTFS_GB[112]="64"
CT_ROOTFS_GB[113]="10"
readonly -a CT_ROOTFS_GB

CT_STARTUP_ORDER=()
CT_STARTUP_ORDER[102]="30"
CT_STARTUP_ORDER[110]="10"
CT_STARTUP_ORDER[112]="20"
CT_STARTUP_ORDER[113]="15"
readonly -a CT_STARTUP_ORDER

CT_DOCKER_COUNT=()
CT_DOCKER_COUNT[102]="13"
CT_DOCKER_COUNT[110]="11"
CT_DOCKER_COUNT[112]="33"
readonly -a CT_DOCKER_COUNT

# The physical host must provide these exact devices for current functionality.
SERVARR_TUN_DEVICE="/dev/net/tun"
INFRA_TUN_DEVICE="/dev/net/tun"
APPS_DRI_CARD="/dev/dri/card1"
APPS_DRI_RENDER="/dev/dri/renderD128"

# Router configuration is deliberately expressed as a verifiable contract.
# The script does not mutate the router or open public ports.
ROUTER_DHCP_DNS="$PIHOLE_IP"
ROUTER_TCP_FORWARD_TARGET="${CT_IP[110]}"
ROUTER_TCP_FORWARD_PORTS="80 443"
