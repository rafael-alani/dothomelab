# The production file is /root/.env on the Proxmox host.
TZ=Europe/Amsterdam

# Native recovery. Existing credentials/state are normally restored from
# /srv/appdata/docker/recovery by scripts/capture-native-recovery.sh.
INFRA_ADMIN_USER=afa
# INFRA_ADMIN_PASSWORD=replace-only-when-no-captured-account-hash-exists
# SAMBA_PASSWORD=replace-only-when-no-captured-passdb-exists
# TAILSCALE_AUTH_KEY=tskey-auth-replace-only-when-no-captured-state-exists

# PBS can restore its current root credential and encryption key from appdata
# after the one-time native-state capture. For a PBS-only restore, provide the
# encryption key separately through one of these options.
# PBS_ROOT_PASSWORD=replace-to-set-a-new-pbs-root-password
# PBS_ENCRYPTION_KEY_FILE=/root/pbs-appdata.key
# PBS_ENCRYPTION_KEY_B64=base64-encoded-pbs-client-key-json

# Home Assistant protected native backups use this password. Keep the same
# value with /root/.env so a clean-node restore can unlock the exported archive.
# Generate with: openssl rand -base64 32
HA_BACKUP_PASSWORD=replace-with-generated-strong-password

# Proton creates Obsidian, Photos, and Environment generation directories below
# this non-secret root. The runner permanently retains at most two of each.
PROTON_BACKUP_REMOTE_ROOT=/my-files/Backups/dothomelab
# Archive part size; 4096M limits local/remote verification scratch per part.
# PROTON_BACKUP_CHUNK_SIZE=4096M

# Syncthing stays loopback-only and NPM publishes its authenticated GUI only to
# LAN/Tailscale. Generate the password with: openssl rand -base64 32
SYNCTHING_GUI_USERNAME=rafael
SYNCTHING_GUI_PASSWORD=replace-with-generated-strong-password

# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=replace-with-64-hex-characters

# Pi-hole keeps its existing LAN service address after LXC 100 is retired.
PIHOLE_BIND_ADDRESS=192.168.0.100
PIHOLE_DNS_PORT=53
PIHOLE_NTP_PORT=123

# Preserve the public origin records and their existing Cloudflare proxy
# policies. Existing records keep their dashboard-selected proxy status;
# PROXIED is the fallback for newly created records.
DOMAINS=rafael.ink,pictures.rafael.ink,stream.rafael.ink,join-stream.rafael.ink
PROXIED=true
IP6_PROVIDER=none
CLOUDFLARE_API_TOKEN=replace-with-existing-cloudflare-api-token

# Servarr runs application processes as this numeric account.
SERVARR_PUID=1000
SERVARR_PGID=1000

# Preserve the current VPN identity; never commit the production private key.
SERVARR_VPN_TYPE=wireguard
SERVARR_VPN_SERVICE_PROVIDER=protonvpn
SERVARR_WIREGUARD_PRIVATE_KEY=replace-with-existing-wireguard-private-key
SERVARR_FIREWALL_OUTBOUND_SUBNETS=192.168.0.0/24

# Preserve the existing NZBGet credentials during migration.
NZBGET_USER=replace-with-existing-user
NZBGET_PASS=replace-with-existing-password

# Immich remains manual in WUD and is upgraded only through documented checkpoints.
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_USERNAME=postgres
IMMICH_DB_PASSWORD=replace-with-existing-immich-database-password
IMMICH_UPLOAD_LOCATION=/srv/appdata/docker/immich/upload
IMMICH_DB_DATA_LOCATION=/srv/appdata/docker/immich/postgres
IMMICH_EXTERNAL_LIBRARY_LOCATION=/data/media/photos

# Apps services.
MEALIE_BASE_URL=https://mealie.rafael.media
JELLYSTAT_POSTGRES_PASSWORD=replace-with-generated-postgresql-password
JELLYSTAT_JWT_SECRET=replace-with-generated-64-hex-character-secret
ZOTERO_WEBDAV_USERNAME=zotero
ZOTERO_WEBDAV_PASSWORD=replace-with-generated-webdav-password

# slskd uses a separate Soulseek identity, authenticated private web UI, and
# a dedicated API key for DroppedNeedle. Generate the last three secrets with:
# openssl rand -hex 32
SLSKD_SOULSEEK_USERNAME=replace-with-soulseek-username
SLSKD_SOULSEEK_PASSWORD=replace-with-soulseek-password
SLSKD_WEB_USERNAME=rafael
SLSKD_WEB_PASSWORD=replace-with-64-hex-characters
SLSKD_API_KEY=replace-with-64-hex-characters
SLSKD_JWT_KEY=replace-with-64-hex-characters

# DroppedNeedle creates its first administrator through the private web UI.
# Its slskd URL is http://slskd:5030 and it consumes SLSKD_API_KEY there.

# Bar Assistant requires a long Meilisearch master key. Its frontend, API,
# and search routes are private to the LAN and Tailscale.
# Generate with: openssl rand -hex 32
BAR_ASSISTANT_MEILI_MASTER_KEY=replace-with-64-hex-characters

# yt-dlp Web UI has application authentication even though NPM also limits the
# route to LAN/Tailscale. Generate the JWT secret with: openssl rand -hex 32
YTDLP_WEBUI_USERNAME=rafael
YTDLP_WEBUI_PASSWORD=replace-with-generated-webui-password
YTDLP_WEBUI_JWT_SECRET=replace-with-64-hex-characters

# SnapOtter uses private PostgreSQL 17 and Redis 8. These initial credentials
# are consumed only when the first database/admin account is created.
# Generate both passwords with: openssl rand -hex 32
SNAPOTTER_DB_PASSWORD=replace-with-64-hex-characters
SNAPOTTER_INITIAL_USERNAME=rafael
SNAPOTTER_INITIAL_PASSWORD=replace-with-64-hex-characters

# Stirling-PDF login is mandatory even though its NPM route is private. The
# initial password is consumed only when the first administrator is created.
# Generate with: openssl rand -hex 32
STIRLING_PDF_INITIAL_USERNAME=rafael
STIRLING_PDF_INITIAL_PASSWORD=replace-with-64-hex-characters

# Create a dedicated read-only key with the scopes documented in
# hosts/apps/immichframe/README.md.
IMMICHFRAME_API_KEY=replace-with-scoped-immich-api-key

# Prometheus and Loki require no production secrets. Their Git-managed
# retention, storage, proxy, Homarr, and manual-update policy is documented in
# docs/observability-addition-2026-07-25.md.

# Audiobookshelf and Kavita create their first administrator through their
# private web interfaces. The Audiobookshelf integration initializer creates
# a library-scoped Shelfarr application key after Audiobookshelf is running
# and writes it only to production /root/.env without displaying it. Appdata,
# read-only libraries, podcast mounts, proxy, Homarr, and WUD policy are
# documented in hosts/apps/{audiobookshelf,kavita}/README.md.
AUDIOBOOKSHELF_SHELFARR_API_KEY=replace-with-generated-scoped-application-key

# Shelfarr and BookOrbit. The idempotent
# scripts/initialize-shelfarr-bookorbit-env.py initializer persists the
# canonical app URL and writes every generated secret only to production
# /root/.env without displaying values.
SHELFARR_SECRET_KEY_BASE=replace-with-generated-128-hex-character-secret
SHELFARR_ADMIN_PASSWORD=replace-with-generated-strong-password
SHELFARR_API_TOKEN=replace-with-generated-shelfarr-api-token
BOOKORBIT_APP_URL=https://bookorbit.rafael.media
BOOKORBIT_DB_PASSWORD=replace-with-generated-postgresql-password
BOOKORBIT_JWT_SECRET=replace-with-generated-64-hex-character-secret
BOOKORBIT_SETUP_BOOTSTRAP_TOKEN=replace-with-generated-32-hex-character-token
BOOKORBIT_ADMIN_PASSWORD=replace-with-generated-strong-password
BOOKORBIT_OPDS_PASSWORD=replace-with-generated-strong-password

# Storyteller. scripts/initialize-storyteller-env.py creates and preserves this
# recovery value; the bootstrap renders it to an application-owned Docker
# secret file without displaying it.
STORYTELLER_SECRET_KEY=replace-with-generated-base64-secret
STORYTELLER_ADMIN_EMAIL=admin@rafael.media
STORYTELLER_ADMIN_FULL_NAME=Rafael Alani
STORYTELLER_ADMIN_USERNAME=rafael
STORYTELLER_ADMIN_PASSWORD=replace-with-generated-strong-password
# PinePods. scripts/initialize-pinepods-env.py idempotently creates and
# preserves the live database, Valkey, and administrator values without
# displaying them. Replace placeholders only in production /root/.env; never
# commit generated values.
PINEPODS_DB_PASSWORD=replace-with-generated-postgresql-password
PINEPODS_VALKEY_PASSWORD=replace-with-generated-valkey-password
PINEPODS_ADMIN_EMAIL=admin@rafael.media
PINEPODS_ADMIN_FULL_NAME=Rafael Alani
PINEPODS_ADMIN_USERNAME=rafael
PINEPODS_ADMIN_PASSWORD=replace-with-generated-strong-password

# Aurral, Soularr, and Navidrome. The music-pipeline initializer extracts and
# preserves Lidarr's recovered API key, creates a distinct Aurral Soulseek
# identity, and generates application/integration credentials without printing
# them. Soularr automatic runs remain paused until the large recovered Lidarr
# monitoring set is curated.
LIDARR_API_KEY=replace-with-recovered-lidarr-api-key
AURRAL_ADMIN_EMAIL=admin@rafael.media
AURRAL_ADMIN_USERNAME=rafael
AURRAL_ADMIN_PASSWORD=replace-with-generated-strong-password
AURRAL_SOULSEEK_USERNAME=replace-with-distinct-soulseek-username
AURRAL_SOULSEEK_PASSWORD=replace-with-generated-strong-password
AURRAL_LASTFM_API_KEY=replace-with-lastfm-api-key
AURRAL_LASTFM_USERNAME=replace-with-lastfm-username
NAVIDROME_ADMIN_USERNAME=rafael
NAVIDROME_ADMIN_PASSWORD=replace-with-generated-strong-password
NAVIDROME_AURRAL_USERNAME=aurral-integration
NAVIDROME_AURRAL_PASSWORD=replace-with-generated-strong-password
SOULARR_SCHEDULER_ENABLED=false

# n8n and Pulse run as separate private Compose projects on Infra. Preserve the
# n8n encryption key with appdata or stored workflow credentials are lost.
# scripts/initialize-n8n-pulse-env.py securely creates missing live values.
N8N_ENCRYPTION_KEY=replace-with-64-hex-characters
N8N_ADMIN_EMAIL=admin@rafael.media
N8N_ADMIN_FIRST_NAME=Rafael
N8N_ADMIN_LAST_NAME=Alani
N8N_ADMIN_PASSWORD=replace-with-generated-owner-password
PULSE_AUTH_USER=rafael
PULSE_AUTH_PASS=replace-with-generated-pulse-password
# Created by hosts/infra/pulse/configure-monitoring.py; never commit its value.
PULSE_PVE_TOKEN_SECRET=replace-with-proxmox-api-token-secret

# Paperless-ngx and Paperless-GPT. Both reverse-proxy routes are private to
# the LAN and Tailscale; Paperless-GPT has no native authentication.
# scripts/initialize-paperless-env.py creates every local value below except
# PAPERLESS_GPT_OPENAI_API_KEY, which must be supplied externally.
PAPERLESS_DB_PASSWORD=replace-with-generated-postgresql-password
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=replace-with-64-hex-characters
PAPERLESS_ADMIN_USER=rafael
PAPERLESS_ADMIN_MAIL=rafael@localhost
PAPERLESS_ADMIN_PASSWORD=replace-with-generated-admin-password
# A Django REST Framework token is exactly 40 hexadecimal characters.
# Generate with: openssl rand -hex 20
PAPERLESS_GPT_SERVICE_USER=paperless-gpt
PAPERLESS_GPT_API_TOKEN=replace-with-40-hex-characters
PAPERLESS_GPT_OPENAI_API_KEY=replace-with-openai-api-key
PAPERLESS_GPT_LLM_MODEL=gpt-4o-mini
PAPERLESS_GPT_VISION_MODEL=gpt-4o-mini
PAPERLESS_GPT_LLM_LANGUAGE=English
